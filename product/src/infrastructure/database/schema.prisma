generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id         String   @id @default(uuid())
  name       String
  priceCents Int
  tags       String   @default("") // SQLite n'ayant pas de type tableau natif, on stocke "a,b,c"
  createdAt  DateTime @default(now())
}
